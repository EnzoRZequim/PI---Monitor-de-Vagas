{
  "compilerOptions": {
    // File Layout
    "rootDir": "./backend/src",
    "outDir": "./dist",

    // Environment Settings
    "module": "commonjs",
    "target": "esnext",
    "types": ["node"],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },

  "include": [
    "backend/src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "data",
    "PKLot.v2-640.coco"
  ]
}